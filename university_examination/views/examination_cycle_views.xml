<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_examination_cycle_form" model="ir.ui.view">
        <field name="name">examination.cycle.form</field>
        <field name="model">examination.cycle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="academic_year_id"/>
                            <field name="semester"/>
                        </group>
                        <group>
                            <field name="exam_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_examination_cycle" model="ir.actions.act_window">
        <field name="name">Examination Cycles</field>
        <field name="res_model">examination.cycle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_examination_cycle" name="Examination Cycles" parent="menu_university_examination_root" action="action_examination_cycle" sequence="10"/>
</odoo>
