<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_examination_board_session_form" model="ir.ui.view">
        <field name="name">examination.board.session.form</field>
        <field name="model">examination.board.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" type="object" string="Open" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_close" type="object" string="Close Session" invisible="state != 'open'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Session Name..." readonly="state == 'closed'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="board_type" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Adjustments">
                            <field name="adjustment_ids" context="{'default_session_id': id}" readonly="state == 'closed'">
                                <list editable="bottom">
                                    <field name="adjustment_type"/>
                                    <field name="student_id" invisible="adjustment_type == 'column'" required="adjustment_type == 'row'"/>
                                    <field name="subject_id"/>
                                    <field name="marks_added"/>
                                    <field name="justification"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_examination_board_session_list" model="ir.ui.view">
        <field name="name">examination.board.session.list</field>
        <field name="model">examination.board.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="board_type"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'open'" decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="action_examination_board_session" model="ir.actions.act_window">
        <field name="name">Board Sessions</field>
        <field name="res_model">examination.board.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_examination_board" name="Board Meetings" parent="menu_university_examination_root" action="action_examination_board_session" sequence="50"/>
</odoo>
