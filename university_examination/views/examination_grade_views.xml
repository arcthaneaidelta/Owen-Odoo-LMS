<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. The Grade Entry views (List and Form) -->
    <record id="view_examination_grade_entry_search" model="ir.ui.view">
        <field name="name">examination.grade.entry.search</field>
        <field name="model">examination.grade.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="batch_id"/>
            </search>
        </field>
    </record>

    <record id="view_examination_grade_entry_kanban" model="ir.ui.view">
        <field name="name">examination.grade.entry.kanban</field>
        <field name="model">examination.grade.entry</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="student_id"/>
                <field name="batch_id"/>
                <field name="cycle_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="student_id"/></strong>
                                <div><field name="cycle_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_examination_grade_entry_form" model="ir.ui.view">
        <field name="name">examination.grade.entry.form</field>
        <field name="model">examination.grade.entry</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" domain="[('batch_id', '=', batch_id)]"/>
                            <field name="batch_id"/>
                        </group>
                        <group>
                            <field name="cycle_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subject Grades">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="assignment_score"/>
                                    <field name="midterm_score"/>
                                    <field name="practical_score"/>
                                    <field name="attendance_score"/>
                                    <field name="exam_score"/>
                                    <field name="total_score"/>
                                    <field name="subject_point"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_examination_grade_entry_tree" model="ir.ui.view">
        <field name="name">examination.grade.entry.tree</field>
        <field name="model">examination.grade.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="batch_id"/>
                <field name="cycle_id"/>
            </list>
        </field>
    </record>

    <!-- 2. Action to open Grade Entries for a specific batch -->
    <record id="action_examination_grade_entry" model="ir.actions.act_window">
        <field name="name">Student Grade Entries</field>
        <field name="res_model">examination.grade.entry</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('batch_id', '=', active_id)]</field>
        <field name="context">{'default_batch_id': active_id}</field>
    </record>

    <!-- 3. The Batch Kanban view for Grade Entry -->
    <record id="view_batch_grade_entry_kanban" model="ir.ui.view">
        <field name="name">university.batch.grade.entry.kanban</field>
        <field name="model">university.batch</field>
        <field name="arch" type="xml">
            <kanban create="false" action="%(action_examination_grade_entry)d" type="action">
                <field name="name"/>
                <field name="program_id"/>
                <field name="evaluation_method"/>
                <field name="student_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="program_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge rounded-pill text-bg-info me-2"><field name="evaluation_method"/></span>
                                    <span class="badge rounded-pill text-bg-secondary"><i class="fa fa-users me-1" title="Students Enrolled"/> <field name="student_count"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 4. Action for the main Grade Entry menu -->
    <record id="action_grade_entry_batch_kanban" model="ir.actions.act_window">
        <field name="name">Select Batch for Grade Entry</field>
        <field name="res_model">university.batch</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('state', '=', 'active')]</field>
        <field name="view_id" ref="view_batch_grade_entry_kanban"/>
    </record>

    <menuitem id="menu_examination_grade" name="Grade Entry" parent="menu_university_examination_root" action="action_grade_entry_batch_kanban" sequence="40"/>
</odoo>
