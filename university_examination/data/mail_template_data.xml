<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="email_template_exam_otp_v2" model="mail.template">
            <field name="name">Exam Paper Upload: OTP Verification</field>
            <field name="model_id" ref="university_examination.model_examination_paper_upload"/>
            <field name="subject">OTP for Exam Paper Upload</field>
            <field name="email_to">{{ object.teacher_id.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.teacher_id.name"/>,</p>
                    <p>Your OTP code for verifying your examination paper upload is: <strong><t t-out="object.generated_otp_code"/></strong></p>
                    <p>Please enter this code in the system to complete the verification process.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
