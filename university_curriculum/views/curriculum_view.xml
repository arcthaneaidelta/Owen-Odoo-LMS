<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_curriculum_form" model="ir.ui.view">
        <field name="name">university.curriculum.form</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <form string="Curriculum Blueprint">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_lock" string="Lock Blueprint" type="object"
                            class="btn-warning"
                            invisible="is_locked or state != 'active'"/>
                    <button name="action_duplicate_as_new_version"
                            string="Duplicate as New Version" type="object"
                            invisible="not is_locked"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button type="object" name="action_view_subjects"
                                class="oe_stat_button" icon="fa-book">
                            <field name="subject_count" widget="statinfo" string="Subjects"/>
                        </button> -->
                    </div>
                    <widget name="web_ribbon" title="Locked"
                            bg_color="text-bg-warning"
                            invisible="not is_locked"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="curriculum_type"/>
                            <field name="code"/>
                            <field name="program_id"/>
                            <field name="college_id"/>
                            <field name="academic_year_name"/>
                            <field name="version"/>
                            <field name="is_locked" readonly="1"/>
                        </group>
                        <group string="Links">
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="batch_id" invisible="curriculum_type != 'batch'"/>
                            <field name="student_id" invisible="curriculum_type != 'student'"/>
                        </group>

                        <group string="Totals">
                            <field name="total_credit_hours"/>
                            <field name="total_lecture_hours"/>
                            <field name="total_practical_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subjects">
                            <field name="line_ids" readonly="is_locked">
                                <list editable="bottom">
                                    <field name="year_level"/>
                                    <field name="semester"/>
                                    <field name="subject_id"/>
                                    <field name="specialization_id" column_invisible="parent.has_specialization == False"/>
                                    <field name="lecture_hours"/>
                                    <field name="tutorial_hours"/>
                                    <field name="practical_hours"/>
                                    <field name="clinical_hours" optional="hide"/>
                                    <field name="lecturer_id" optional="show"/>
                                    <field name="tutor_id" optional="show"/>
                                    <field name="instructor_id" optional="show"/>
                                    <field name="credit_hours"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_curriculum_list" model="ir.ui.view">
        <field name="name">university.curriculum.list</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <list string="Curricula"
                  decoration-muted="is_locked">
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="academic_year_name"/>
                <field name="version"/>
                <field name="subject_count"/>
                <field name="total_credit_hours"/>
                <field name="is_locked" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-info="state=='draft'"
                       decoration-muted="state=='deprecated'"/>
            </list>
        </field>
    </record>

    <record id="view_curriculum_kanban" model="ir.ui.view">
        <field name="name">university.curriculum.kanban</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <kanban default_group_by="program_id" class="o_kanban_small_column" sample="1" group_create="false" quick_create="false">
                <field name="name"/>
                <field name="program_id"/>
                <field name="version"/>
                <field name="state"/>
                <field name="is_locked"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title h5">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'active': 'success', 'deprecated': 'warning'}}"/>
                            </div>
                            <div class="o_kanban_record_body mt-1">
                                <div class="text-muted">Version: <field name="version"/></div>
                                <div><field name="code"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.is_locked.raw_value" class="badge text-bg-warning">
                                        <i class="fa fa-lock me-1"/> Locked
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_curriculum_search" model="ir.ui.view">
        <field name="name">university.curriculum.search</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="academic_year_name"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <group expand="1" string="Group By">
                    <filter string="Program" name="group_program" context="{'group_by':'program_id'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by':'academic_year_name'}"/>
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_university_curriculum" model="ir.actions.act_window">
        <field name="name">Curriculum Blueprints</field>
        <field name="res_model">university.curriculum</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_curriculum_search"/>
        <field name="context">{'search_default_group_program': 1}</field>
    </record>
</odoo>
