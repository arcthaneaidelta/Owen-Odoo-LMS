<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">university.subject.form</field>
        <field name="model">university.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name_ar" class="o_rtl" placeholder="اسم المادة"/></h1>
                        <h2><field name="name" placeholder="Subject Name (English)"/></h2>
                        <!-- <h2><field name="name"/></h2> -->
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="department_id"/>
                            <field name="program_id" invisible="is_elective"/>
                            <field name="subject_type"/>
                            <field name="is_elective"/>
                        </group>
                        <group string="Hours &amp; Credits">
                            <field name="lecture_hours"/>
                            <field name="tutorial_hours"/>
                            <field name="practical_hours"/>
                            <field name="clinical_hours"/>
                            <field name="credit_hours" readonly="1"/>
                            <field name="year_level"/>
                            <field name="semester"/>
                            <!-- <field name="passing_score"/> -->
                        </group>
                    </group>
                   <!--  <notebook>
                        <page string="Assessment Configuration">
                            <field name="assessment_config_ids">
                                <list editable="bottom">
                                    <field name="curriculum_id"/>
                                    <field name="assignment_pct"/>
                                    <field name="midterm_pct"/>
                                    <field name="practical_pct"/>
                                    <field name="attendance_pct"/>
                                    <field name="final_pct"/>
                                    <field name="total_pct" readonly="1" widget="percentage"/>
                                </list>
                            </field>
                        </page>

                        <page string="Prerequisites"
                              invisible="not is_prerequisite_required">
                            <field name="is_prerequisite_required"/>
                            <field name="prerequisite_ids"/>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook> -->
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">university.subject.list</field>
        <field name="model">university.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects">
                <field name="code"/>
                <field name="name_ar"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="program_id"/>
                <field name="year_level"/>
                <field name="semester"/>
                <!-- <field name="lecture_hours"/>
                <field name="tutorial_hours" optional="show"/>
                <field name="practical_hours"/>
                <field name="clinical_hours" optional="show"/>
                <field name="credit_hours"/>
                <field name="subject_type"/> -->
                <field name="is_elective" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_subject_search" model="ir.ui.view">
        <field name="name">university.subject.search</field>
        <field name="model">university.subject</field>
        <field name="arch" type="xml">
            <search>
                <field name="name_ar"/>
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <filter string="Theory" name="theory" domain="[('subject_type','=','theory')]"/>
                <filter string="Practical" name="practical" domain="[('subject_type','in',['practical','mixed'])]"/>
                <filter string="Elective" name="elective" domain="[('is_elective','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="grp_dept" context="{'group_by':'department_id'}"/>
                    <filter string="Year Level" name="grp_year" context="{'group_by':'year_level'}"/>
                    <filter string="Semester" name="grp_sem" context="{'group_by':'semester'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_subject_kanban" model="ir.ui.view">
        <field name="name">university.subject.kanban</field>
        <field name="model">university.subject</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name_ar"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="department_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title h5">
                                            <field name="name" invisible="not name"/>
                                            <t t-if="!record.name.raw_value"><field name="name_ar"/></t>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mt-2">
                                    <div t-if="record.program_id.raw_value" class="text-muted">
                                        <i class="fa fa-graduation-cap me-1"/> <field name="program_id"/>
                                    </div>
                                    <div t-if="record.department_id.raw_value" class="text-muted mt-1">
                                        <i class="fa fa-building me-1"/> <field name="department_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_university_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">university.subject</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_subject_search"/>
    </record>
</odoo>
