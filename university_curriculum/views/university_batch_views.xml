<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_form_inherit_curriculum" model="ir.ui.view">
        <field name="name">university.batch.form.inherit.curriculum</field>
        <field name="model">university.batch</field>
        <field name="inherit_id" ref="university_core.view_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[2]/field[@name='capacity']" position="before">
                <field name="curriculum_id" readonly="curriculum_locked"/>
                <field name="curriculum_locked" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
