<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_curriculum" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.curriculum</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="university_core.view_employee_form_inherit_university"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='academic_qualification']" position="after">
                <field name="university_subject_ids" widget="many2many_tags" required="is_teacher"/>
            </xpath>
        </field>
    </record>
</odoo>
