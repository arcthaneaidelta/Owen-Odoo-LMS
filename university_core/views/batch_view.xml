<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_batch_form" model="ir.ui.view">
        <field name="name">university.batch.form</field>
        <field name="model">university.batch</field>
        <field name="arch" type="xml">
            <form string="Batch">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" string="Mark Completed" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_archive_batch" string="Archive" type="object"
                            invisible="state not in ('completed',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">

                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="batch_number" readonly="1"/></h2>
                        <!-- <h2 invisible="batch_number != 'New'"><field name="name" readonly="1"/></h2> -->
                        <!-- <h2 invisible="batch_number == 'New'"><field name="name" readonly="1"/></h2> -->
                        <!-- <h3>
                            <field name="code" readonly="1"/>
                        </h3> -->
                    </div>
                    <group>
                        <group string="Batch Info">
                            <field name="batch_year"/>
                            <field name="program_id"/>
                            <field name="college_id"/>
                            <field name="university_id"/>
                            <field name="current_academic_year_name"/>
                        </group>
                        <group string="Settings">
                            <field name="capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Academic Years" name="academic_years">
                            <field name="academic_year_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="registration_deadline"/>
                                    <field name="late_registration_deadline"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_batch_list" model="ir.ui.view">
        <field name="name">university.batch.list</field>
        <field name="model">university.batch</field>
        <field name="arch" type="xml">
            <list string="Batches">
                <field name="batch_number"/>
                <field name="name"/>
                <field name="batch_year"/>
                <field name="program_id"/>
                <field name="college_id"/>
                <field name="current_academic_year_name"/>

                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-warning="state=='draft'"
                       decoration-muted="state in ('completed','archived')"/>
            </list>
        </field>
    </record>

    <record id="view_batch_search" model="ir.ui.view">
        <field name="name">university.batch.search</field>
        <field name="model">university.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="program_id"/>
                <field name="college_id"/>
                <field name="batch_year"/>
                <filter string="Active" name="active" domain="[('state','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <group expand="1" string="Group By">
                    <filter string="Program" name="group_program" context="{'group_by':'program_id'}"/>
                    <filter string="College" name="group_college" context="{'group_by':'college_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by':'batch_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_batch_kanban" model="ir.ui.view">
        <field name="name">university.batch.kanban</field>
        <field name="model">university.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="program_id" class="o_kanban_small_column" sample="1">
                <field name="name"/>
                <field name="program_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'active': 'success', 'completed': 'warning'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="batch_number"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="batch_year"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_program_batch_dashboard_kanban" model="ir.ui.view">
        <field name="name">university.program.batch.dashboard.kanban</field>
        <field name="model">university.program</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" action="action_view_batches" type="object">
                <field name="id"/>
                <field name="name_en"/>
                <field name="name_ar"/>
                <field name="batch_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title h4">
                                        <field name="name_en" t-if="record.name_en.raw_value"/>
                                        <field name="name_ar" t-if="!record.name_en.raw_value"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-3">
                                <div class="text-center">
                                    <span class="badge rounded-pill text-bg-primary p-2 px-3" style="font-size: 1.1em;">
                                        <field name="batch_count"/> Batches
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="text-muted small">
                                    Click to manage batches for this program
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_university_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">university.program</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_program_batch_dashboard_kanban"/>
        <field name="search_view_id" ref="view_program_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage your student batches by program.
            </p>
        </field>
    </record>
</odoo>
