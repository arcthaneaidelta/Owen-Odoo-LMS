<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ UNIVERSITY FORM VIEW ════════════════════════════════════════════ -->
    <record id="view_university_form" model="ir.ui.view">
        <field name="name">university.university.form</field>
        <field name="model">university.university</field>
        <field name="arch" type="xml">
            <form string="University">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(university_core.action_university_college)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-university">
                            <field name="college_count" widget="statinfo" string="Colleges"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="University Name"/></h1>
                        <label for="name_ar"/>
                        <h2><field name="name_ar" placeholder="اسم الجامعة" class="o_rtl"/></h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="name_en"/>
                            <field name="code"/>
                            <field name="ministry_registration_number"/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address"/>
                        <field name="city"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                    </group>
                    <notebook>
                        <page string="Colleges" name="colleges">
                            <field name="college_ids">
                                <list>
                                    <!-- <column_invisible>1</column_invisible> -->
                                    <field name="name_ar"/>
                                    <field name="name_en"/>
                                    <field name="code"/>
                                    <field name="dean_name"/>
                                    <field name="program_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══ UNIVERSITY LIST VIEW ════════════════════════════════════════════ -->
    <record id="view_university_list" model="ir.ui.view">
        <field name="name">university.university.list</field>
        <field name="model">university.university</field>
        <field name="arch" type="xml">
            <list string="Universities">
                <field name="name"/>
                <field name="name_ar"/>
                <field name="code"/>
                <field name="ministry_registration_number"/>
                <field name="college_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ═══ UNIVERSITY SEARCH VIEW ══════════════════════════════════════════ -->
    <record id="view_university_search" model="ir.ui.view">
        <field name="name">university.university.search</field>
        <field name="model">university.university</field>
        <field name="arch" type="xml">
            <search string="Search Universities">
                <field name="name"/>
                <field name="name_ar"/>
                <field name="code"/>
                <field name="ministry_registration_number"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ═══ ACTION ══════════════════════════════════════════════════════════ -->
    <record id="action_university_university" model="ir.actions.act_window">
        <field name="name">Universities</field>
        <field name="res_model">university.university</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_university_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first university record.
            </p>
        </field>
    </record>

</odoo>
