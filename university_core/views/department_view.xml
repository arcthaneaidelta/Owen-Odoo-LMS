<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form" model="ir.ui.view">
        <field name="name">university.department.form</field>
        <field name="model">university.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name_ar" class="o_rtl"/></h1>
                        <h2><field name="name"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="college_id"/>
                            <field name="university_id"/>
                        </group>
                        <group>
                            <field name="head_name"/>
                            <field name="head_employee_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_department_list" model="ir.ui.view">
        <field name="name">university.department.list</field>
        <field name="model">university.department</field>
        <field name="arch" type="xml">
            <list><field name="name_ar"/><field name="name"/><field name="code"/><field name="college_id"/><field name="head_name"/></list>
        </field>
    </record>
    <record id="action_university_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">university.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
