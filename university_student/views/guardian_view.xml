<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_guardian_form" model="ir.ui.view">
        <field name="name">university.guardian.form</field>
        <field name="model">university.guardian</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="name"/>
                            <field name="relationship"/>
                            <field name="is_emergency_contact" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="phone_1"/>
                            <field name="phone_1_country_id" invisible="1"/>
                            <field name="phone_2"/>
                            <field name="phone_whatsapp"/>
                            <field name="whatsapp_country_id" invisible="1"/>
                            <field name="email"/>
                            <field name="national_id"/>
                        </group>
                    </group>
                    <field name="address"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_university_guardian" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">university.guardian</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
