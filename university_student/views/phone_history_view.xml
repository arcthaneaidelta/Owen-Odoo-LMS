<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_phone_history_list" model="ir.ui.view">
        <field name="name">university.student.phone.list</field>
        <field name="model">university.student.phone</field>
        <field name="arch" type="xml">
            <list string="Phone History" editable="bottom">
                <field name="student_id"/>
                <field name="phone_number"/>
                <field name="is_whatsapp"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="date_added"/>
                <field name="date_deprecated"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    <record id="action_student_phone_history" model="ir.actions.act_window">
        <field name="name">Phone History</field>
        <field name="res_model">university.student.phone</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
