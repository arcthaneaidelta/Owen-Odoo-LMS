<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Record rules: students can only read their own record -->
        <record id="rule_student_portal_own_record" model="ir.rule">
            <field name="name">Student Portal: Own Record Only</field>
            <field name="model_id" search="[('model','=','university.student')]"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Teachers can only see students in their batches (read only) -->
        <record id="rule_student_teacher_batch" model="ir.rule">
            <field name="name">Teacher: Read All Students (View-Level Filtering)</field>
            <field name="model_id" search="[('model','=','university.student')]"/>
            <field name="groups" eval="[(4, ref('university_core.group_teacher'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
