<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_mark_absentees_cre" model="ir.cron">
        <field name="name">HR: Mark Absentees</field>
        <field name="interval_number">10</field>
        <field name="interval_type">hours</field>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root" />
        <field name="model_id" ref="model_hr_attendance_absents" />
        <field name="code">model._mark_absentees()</field>
        <field name="active" eval="True" />
    </record>
    <record id="ir_cron_mark_absentees_del" model="ir.cron">
        <field name="name">HR: Mark OLD Deleted Absentees</field>
        <field name="interval_number">11</field>
        <field name="interval_type">hours</field>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root" />
        <field name="model_id" ref="model_hr_attendance_absents" />
        <field name="code">model._mark_old_del_absentees()</field>
        <field name="active" eval="True" />
    </record>
</odoo>