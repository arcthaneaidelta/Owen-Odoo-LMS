<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="hr_attendance_absents_config_tree_view" model="ir.ui.view">
            <field name="name">hr.attendance.absents.view.tree</field>
            <field name="model">hr.attendance.absents</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="company_id" readonly="1" force_save="1" />
                    <field name="employee_id" readonly="1" force_save="1" />
                    <field name="contract_id" readonly="1" force_save="1" />
                    <field name="time" readonly="1" force_save="1" />
                    <field name="user_id" optional="hide" readonly="1" force_save="1" />
                </list>
            </field>
        </record>
        <record id="hr_attendance_absents_search_view" model="ir.ui.view">
            <field name="name">hr.attendance.absents.view.search</field>
            <field name="model">hr.attendance.absents</field>
            <field name="arch" type="xml">
                <search string="Hr Attendance Absents">
                    <field name="company_id" readonly="1" force_save="1" />
                    <field name="user_id" readonly="1" force_save="1" />
                    <field name="employee_id" readonly="1" force_save="1" />
                    <field name="contract_id" readonly="1" force_save="1" />
                    <field name="time" readonly="1" force_save="1" />
                    <group expand="0" string="Group By">
                        <filter string="Date" name="time" domain="[]" context="{'group_by': 'time'}" />
                        <filter string="Contract" name="contract_id" domain="[]" context="{'group_by': 'contract_id'}" />
                        <filter string="Employee" name="employee_id" domain="[]" context="{'group_by': 'employee_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_hr_attendance_absents_config">
            <field name="name">Hr Attendance Absents</field>
            <field name="res_model">hr.attendance.absents</field>
            <field name="view_mode">list</field>
        </record>
        <menuitem id="menu_hr_attendance_absents_config" name="Hr Attendance Absents" parent="employee_hr_portal.menu_payroll_others" sequence="1" action="action_hr_attendance_absents_config" groups="om_hr_payroll.group_hr_payroll_manager" />
    </data>
</odoo>