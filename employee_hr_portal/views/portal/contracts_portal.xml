<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_contracts" name="Contracts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Contracts</t>
            </t>
            <t t-if="not contracts">
                <p>There are currently no contracts.</p>
            </t>
            <t t-if="contracts" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th class="text-left">Contract</th>
                        <th class="text-left">Employee</th>
                        <th class="text-left">Start Date</th>
                        <th class="text-left">Working Schedule</th>
                        <th class="text-left">Department</th>
                        <th class="text-left">Job Position</th>
                        <th class="text-left">Contract Type</th>
                        <th class="text-left">Responsible</th>
                        <th class="text-left"></th>
                        <th class="text-left">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="contracts" t-as="cnt">
                        <tr>
                            <td class="text-left">
                                <a style="text-decoration: underline;color: blue;" t-attf-href="/my/my_contract/#{cnt.id}?{{ keep_query() }}">
                                    <t t-esc="cnt.name" />
                                </a>
                            </td>
                            <td class="text-left"><span t-field="cnt.employee_id.name" /></td>
                            <td class="text-left"><span t-field="cnt.date_start" /></td>
                            <td class="text-left"><span t-field="cnt.date_end" /></td>
                            <td class="text-left"><span t-field="cnt.resource_calendar_id.name" /></td>
                            <td class="text-left"><span t-field="cnt.department_id.name" /></td>
                            <td class="text-left"><span t-field="cnt.job_id.name" /></td>
                            <td class="text-left"><span t-field="cnt.contract_type_id.name" /></td>
                            <td class="text-left"><span t-field="cnt.hr_responsible_id.name" /></td>
                            <td class="text-left">
                                <t t-value="dict(cnt.fields_get(allfields=['state'])['state']['selection'])[cnt.state]" t-set="state" />
                                <t t-if="cnt.state == 'draft'">
                                    <span class="badge badge-pill badge-info" style="background-color: #999999; color: black;" title="Current stage of the contract" t-esc="state" />
                                </t>
                                <t t-if="cnt.state == 'open'">
                                    <span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the contract" t-esc="state" />
                                </t>
                                <t t-if="cnt.state == 'close'">
                                    <span class="badge badge-pill badge-info" style="background-color: #ff0000; color: black;" title="Current stage of the contract" t-esc="state" />
                                </t>
                                <t t-if="cnt.state == 'cancel'">
                                    <span class="badge badge-pill badge-info" style="background-color: #ff7700; color: black;" title="Current stage of the contract" t-esc="state" />
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
    <template id="portal_contract_details" name="My Contract">
        <div class="card mt-4">
            <div class="card mt-4">
                <div class="card-header">
                    <div class="row g-0 align-items-center p-3 bg-primary text-white rounded-top">
                        <div class="col-md">
                            <h5 class="mb-0">
                                <span t-field="contract.name" />
                            </h5>
                        </div>
                        <div class="col-md text-md-end">
                            <span t-field="contract.state" class="badge rounded-pill bg-light text-dark" title="Current status of the contract" />
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <h6 class="text-primary">Contract Details</h6>
                                    <p><strong>Contract:</strong> <span t-field="contract.name" /></p>
                                    <p><strong>Employee:</strong> <span t-field="contract.employee_id.name" /></p>
                                    <p><strong>Start Date:</strong> <span t-field="contract.date_start" /></p>
                                    <p><strong>Working Schedule:</strong> <span t-field="contract.resource_calendar_id.name" /></p>
                                    <p><strong>Wage Type:</strong> <span t-field="contract.schedule_pay" /></p>
                                    <!-- <p><strong>Basic Salary:</strong> <span t-field="contract.basic_salary" /></p> -->
                                    <p><strong>Living Allowance:</strong> <span t-field="contract.hra" /></p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <h6 class="text-primary">Company Details</h6>
                                    <p><strong>Department:</strong> <span t-field="contract.department_id.name" /></p>
                                    <p><strong>Job Position:</strong> <span t-field="contract.job_id.name" /></p>
                                    <p><strong>Contract Type:</strong> <span t-field="contract.contract_type_id.name" /></p>
                                    <p><strong>Responsible:</strong> <span t-field="contract.hr_responsible_id.name" /></p>
                                    <!-- <p><strong>Attendance Allowance:</strong> <span t-field="contract.attendance_allowance" /></p> -->
                                    <!-- <p><strong>Showroom Allowance:</strong> <span t-field="contract.showroom_allowance" /></p> -->
                                    <p><strong>Other Allowance:</strong> <span t-field="contract.other_allowance" /></p>
                                    <p><strong>Gross Salary:</strong> <span t-field="contract.wage" /></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt32">
                <h4>
                    <strong>Message and communication history</strong>
                </h4>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="contract" />
                    <t t-set="token" t-value="0" />
                    <t t-set="pid" t-value="pid" />
                    <t t-set="hash" t-value="hash" />
                </t>
            </div>
        </div>
    </template>
</odoo>