<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="portal_my_expenses" name="My Expenses">
		<t t-call="portal.portal_layout">
			<t t-set="breadcrumbs_searchbar" t-value="True" />
			<t t-call="portal.portal_searchbar">
				<t t-set="title">Expenses</t>
			</t>
			<a t-attf-href="/create/my_expenses?{{ keep_query() }}"><button type="button" class="mt-2 mb-2 btn btn-info btn-md" id="create_expensese">Create a Expense</button></a>
			<p class="alert alert-danger mt8" t-if="request.params.get('error_msg')" role="alert">
				<t t-esc="request.params.get('error_msg')" />
			</p>
			<t t-call="portal.portal_table">
				<thead>
					<tr>
						<th>Description</th>
						<th>Category</th>
						<th>Employee</th>
						<th>Total</th>
						<th>Paid By</th>
						<!-- <th>Bill Reference</th> -->
						<th>Date</th>
						<th class="text-right">Status</th>
					</tr>
				</thead>
				<tbody>
					<t t-foreach="expense_requests" t-as="expenses">
						<tr>
							<td><a t-attf-href="/my/expense/#{expenses.id}?{{ keep_query() }}"><span t-field="expenses.name" /></a></td>
							<td><span t-field="expenses.product_id" /></td>
							<td><span t-field="expenses.employee_id" /></td>
							<td><span t-field="expenses.total_amount" /></td>
							<td><span t-field="expenses.payment_mode" /></td>
							<!-- <td><span t-field="expenses.reference" /></td> -->
							<td class="text-right">
								<t t-value="dict(expenses.fields_get(allfields=['state'])['state']['selection'])[expenses.state]" t-set="state" />
								<t t-if="expenses.state == 'draft'">
									<span class="badge badge-pill badge-info" style="background-color: #999999; color: black;" title="Current stage of the task" t-esc="state" />
								</t>
								<t t-if="expenses.state == 'reported'">
									<span class="badge badge-pill badge-info" style="background-color: #ccc; color: black;" title="Current stage of the task" t-esc="state" />
								</t>
								<t t-if="expenses.state == 'approved'">
									<span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-esc="state" />
								</t>
								<t t-if="expenses.state == 'done'">
									<span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-esc="state" />
								</t>
								<t t-if="expenses.state == 'refused'">
									<span class="badge badge-pill badge-info" style="background-color: #ff7700; color: black;" title="Current stage of the task" t-esc="state" />
								</t>
							</td>
							<td>
								<a t-attf-href="/my/expense/delete/#{expenses.id}?{{ keep_query() }}" t-if="expenses.state=='draft'">
									<span class="fa fa-trash-o remove-optionnal-item" title="Delete" aria-label="Delete" />
								</a>
							</td>
						</tr>
					</t>
				</tbody>
			</t>
		</t>
	</template>
	<template id="portal_my_expense" name="My Expense">
		<t t-call="portal.portal_layout">
			<p class="alert alert-danger mt8" t-if="request.params.get('error_msg')" role="alert">
				<t t-esc="request.params.get('error_msg')" />
			</p>
			<form data-model_name="hr.expense" t-attf-action="/expense/update/{{expense.id}}" method="post" class="form-horizontal container-fluid" enctype="multipart/form-data">
				<div class="card mt-4">
					<div class="card-header">
						<div class="row no-gutters">
							<div class="col-md">
								<h5 class="mb-1 mb-md-0">
									<t t-value="dict(expense.fields_get(allfields=['state'])['state']['selection'])[expense.state]" t-set="state" />
									<t t-if="expense.state == 'draft'">
										<span class="badge badge-pill badge-info" style="background-color: #999999; color: black;" title="Current stage of the task" t-esc="state" />
									</t>
									<t t-if="expense.state == 'reported'">
										<span class="badge badge-pill badge-info" style="background-color: #ccc; color: black;" title="Current stage of the task" t-esc="state" />
									</t>
									<t t-if="expense.state == 'approved'">
										<span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-esc="state" />
									</t>
									<t t-if="expense.state == 'done'">
										<span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-esc="state" />
									</t>
									<t t-if="expense.state == 'refused'">
										<span class="badge badge-pill badge-info" style="background-color: #ff7700; color: black;" title="Current stage of the task" t-esc="state" />
									</t>
								</h5>
								<div class="mb-1 mb-md-0 mt-2">
									<span t-if="expense.state == 'draft'" style="color: #606060;">
										Your requested expense is yet to be approved by your expense Manager.
										<br />
										To edit your expense, kindly fill up the updated details and click on save if it is still in new or new stage.
									</span>
									<span t-if="expense.state == 'reported'" style="color: #606060;">
										Your requested expense is yet to be approved by your expense Manager.
										<br />
										To edit your expense, kindly fill up the updated details and click on save if it is still in new or new stage.
									</span>
									<span t-if="expense.state == 'refuse' " class="text-danger">
										Your expense is refused by your expense manager.
									</span>
									<span t-if="expense.state == 'done' " style="color: #0bdb12;">
										Congratulations, your expense is approved by your expense Manager.
									</span>
								</div>
							</div>
						</div>
					</div>
					<div class="card-body">
						<div class="row no-gutters">
							<div class="col-md-12 col-sm-12">
								<div class="form-group mt-2 ">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Description:</label>
										<input id="name" name="name" type="text" string="Description" class="form-control mt-1 col-md-9 col-sm-9" t-att-value="expense.name" required="required" placeholder='xyx..' t-att-readonly="expense.state != 'draft' " t-att-disabled="expense.state != 'draft' " />
									</div>
								</div>
								<div class="form-group mt-2 ">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Date:</label>
										<input id="name" name="date" type="date" onclick="this.showPicker()" string="Date" class="form-control mt-1 col-md-9 col-sm-9" t-att-value="expense.date" required="required" placeholder='2025/12/31 e.g' t-att-readonly="expense.state != 'draft' " t-att-disabled="expense.state != 'draft' " />
									</div>
								</div>
								<div class="form-group mt-2 ">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Amount:</label>
										<input id="total_amount" name="total_amount" type="integer" string="Amount" class="form-control mt-1 col-md-9 col-sm-9" t-att-value="expense.total_amount" required="required" placeholder='1.0' t-att-readonly="expense.state != 'draft' " t-att-disabled="expense.state != 'draft' " />
									</div>
								</div>
								<div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Category:</label>
										<select id="category" name="category" t-attf-class="form-control col-md-9 mt-1 col-sm-9" required="required" t-att-readonly="expense.state != 'draft'" t-att-disabled="expense.state != 'draft' ">
											<t t-foreach="request.env['product.product'].sudo().search([('can_be_expensed', '=', True), '|', ('company_id', '=', False), ('company_id', '=', request.env.company.id)])" t-as="categorys">
												<option t-att-value="categorys.id" t-att-selected="categorys.id == expense.product_id.id" t-att-readonly="expense.state != 'draft' ">
													<t t-esc="categorys.name"></t>
												</option>
											</t>
										</select>
									</div>
								</div>
								<div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Paid By:</label>
										<select id="paid_by" name="paid_by" t-attf-class="form-control col-md-9 mt-1 col-sm-9" required="required" t-att-readonly="expense.state != 'draft'" t-att-disabled="expense.state != 'draft' ">
											<option value="own_account" t-att-selected="paid_by == 'own_account' " t-att-readonly="expense.state != 'draft' ">
												Employee
											</option>
											<option value="company_account" t-att-selected="paid_by == 'company_account' " t-att-readonly="expense.state != 'draft' ">
												Company
											</option>
										</select>
									</div>
								</div>
								<!-- <div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Reference:</label>
										<input type="text" rows="10" cols="10" id="reference" name="reference" t-attf-class="form-control col-md-9 mt-1 col-sm-9" t-att-readonly="expense.state != 'draft'" t-att-disabled="expense.state != 'draft'" t-att-value="expense.reference"></input>
									</div>
								</div> -->
								<div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Notes:</label>
										<textarea rows="10" cols="10" id="description" name="description" t-attf-class="form-control col-md-9 mt-1 col-sm-9" required="required" t-att-readonly="expense.state != 'draft'" t-att-disabled="expense.state != 'draft'" t-att-value="expense.description"><t t-esc="expense.description"></t></textarea>
									</div>
								</div>
								<div class="mt-4 mb-2 col-md text-md-right d-flex">
									<a t-attf-href="/my/my_expenses">
										<button class="btn btn-danger btn-md" type="button" special="cancel">Close</button>
									</a>
									<t t-if="expense.state in ['draft']">
										<button class="btn btn-primary btn-md" type="submit" id="save_expense" style="margin-left:5px;">Update</button>
									</t>
									<a t-attf-href="/my/expense/delete/#{expense.id}?{{ keep_query() }}" t-if="expense.state=='draft'" class="d-flex mt-1" style="margin-left:5px;">
										<span class="fa fa-trash-o fa-2x remove-optionnal-item" title="Delete" aria-label="Delete" />
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="mt32">
					<h4><strong>Message and communication history</strong></h4>
					<t t-call="portal.message_thread" />
				</div>
			</form>
		</t>
	</template>
	<template id="portal_my_expense_create" name="Create a New Expense Request">
		<t t-call="portal.portal_layout">
			<p class="alert alert-danger mt8" t-if="request.params.get('error_msg')" role="alert">
				<t t-esc="request.params.get('error_msg')" />
			</p>
			<form data-model_name="hr.expense" t-attf-action="/create/expense?{{ keep_query() }}" method="post" class="form-horizontal container-fluid" enctype="multipart/form-data">
				<div class="card mt-4">
<div class="card-body">
						<div class="row no-gutters">
							<div class="col-md-12 col-sm-12">
								<div class="form-group mt-2 ">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Description:</label>
										<input id="name" name="name" type="text" string="Description" class="form-control mt-1 col-md-9 col-sm-9" required="required" placeholder='xyx..' />
									</div>
								</div>
								<div class="form-group mt-2 ">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Date:</label>
										<input id="name" name="date" type="date" onclick="this.showPicker()" string="Date" class="form-control mt-1 col-md-9 col-sm-9" required="required" placeholder='2025/12/31 e.g' />
									</div>
								</div>
								<div class="form-group mt-2 ">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Amount:</label>
										<input id="total_amount" name="total_amount" type="integer" string="Amount" class="form-control mt-1 col-md-9 col-sm-9" required="required" placeholder='1.0' />
									</div>
								</div>
								<div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Category:</label>
										<select id="category" name="category" t-attf-class="form-control col-md-9 mt-1 col-sm-9" required="required">
											<t t-foreach="request.env['product.product'].sudo().search([('can_be_expensed', '=', True), '|', ('company_id', '=', False), ('company_id', '=', request.env.company.id)])" t-as="categorys">
												<option t-att-value="categorys.id">
													<t t-esc="categorys.name"></t>
												</option>
											</t>
										</select>
									</div>
								</div>
								<div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Paid By:</label>
										<select id="paid_by" name="paid_by" t-attf-class="form-control col-md-9 mt-1 col-sm-9" required="required">
											<option value="own_account">
												Employee
											</option>
											<option value="company_account">
												Company
											</option>
										</select>
									</div>
								</div>
								<!-- <div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Reference:</label>
										<input type="text" rows="10" cols="10" id="reference" name="reference" t-attf-class="form-control col-md-9 mt-1 col-sm-9"></input>
									</div>
								</div> -->
								<div class="form-group mt-2">
									<div class="col-sm-12">
										<label for="name" class="col-md-2 col-sm-2">Notes:</label>
										<textarea rows="10" cols="10" id="description" name="description" t-attf-class="form-control col-md-9 mt-1 col-sm-9" required="required"></textarea>
									</div>
								</div>
								<div class="mt-4 mb-2 col-md text-md-right d-flex">
									<a t-attf-href="/my/my_expenses">
										<button class="btn btn-danger btn-md" type="button" special="cancel">Close</button>
									</a>
									<button class="btn btn-primary btn-md" type="submit" id="save_expense" style="margin-left:5px;">Create</button>
								</div>
							</div>
						</div>
</div>
				</div>
			</form>
		</t>
	</template>
</odoo>