    <template id="portal_my_home_ext_own" inherit_id="portal.portal_my_home" priority="10">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-if="request.env.user.sudo().has_group('employee_hr_portal.access_to_employee_portal_custom_user')">
                    <style>
                        

                        .o_portal_docs {
                            display: grid !important;
                            grid-template-columns: 1fr 1fr !important;
                            gap: 10px !important;
                        }
                        #portal_service_category {
                            display: contents !important;
                        }
                        .o_portal_docs .o_portal_index_card {
                            height: auto !important;
                            min-height: 72px !important;
                            display: flex !important;
                            align-items: center !important;
                            justify-content: space-between !important;
                            padding: 0.875rem 1.125rem !important;
                            border-radius: 12px !important;
                            border: 0.5px solid #dee2e6 !important;
                            background: #fff !important;
                            margin: 0 !important;
                            box-sizing: border-box !important;
                        }
                        .o_portal_docs .o_portal_index_card h3,
                        .o_portal_docs .o_portal_index_card .h3 {
                            font-size: 15px !important;
                            font-weight: 500 !important;
                            margin: 0 !important;
                            line-height: 1.2 !important;
                        }
                        .o_portal_docs .o_portal_index_card .badge,
                        .o_portal_docs .o_portal_index_card sup {
                            font-size: 12px !important;
                            min-width: 34px !important;
                            text-align: center !important;
                            border-radius: 20px !important;
                        }
                        #portal_common_category .o_portal_index_card {
                            grid-column: span 2 !important;
                        }
                    </style>
                        <t t-call="portal.portal_docs_entry">
                            <t t-set="title">Payslips</t>
                            <t t-set="url" t-value="'/my/my_payslips'"/>
                            <t t-set="placeholder_count" t-value="'employee_payslips_count'"/>
