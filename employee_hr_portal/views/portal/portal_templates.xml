        </xpath>
        <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
            <t t-if="request.env.user.sudo().has_group('employee_hr_portal.access_to_employee_portal_custom_user')">
                <div class="o_portal_my_security mt-3 p-4 border rounded shadow-sm bg-white">
                    <h4 class="text-black mb-3">Employee Details</h4>
                    <hr class="mb-3"/>
                    <t t-if="request.env.user">
                        <t t-set="employee"
                           t-value="request.env['hr.employee'].sudo().search([('user_id', '=', request.env.user.id)], limit=1)"/>
                        <t t-if="employee">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item">
                                    <strong>Name:</strong>
                                    <t t-esc="employee.name"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Department:</strong>
                                    <t t-esc="employee.department_id.name or 'N/A'"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Job Position:</strong>
                                    <t t-esc="employee.job_id.name or 'N/A'"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Manager:</strong>
                                    <t t-esc="employee.parent_id.name or 'N/A'"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Working Hours:</strong>
                                    <t t-esc="employee.resource_calendar_id.name or 'N/A'"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Work Email:</strong>
                                    <t t-esc="employee.work_email or 'N/A'"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Work Mobile:</strong>
                                    <t t-esc="employee.mobile_phone or 'N/A'"/>
                                </li>
                                <li class="list-group-item">
                                    <strong>Work Phone:</strong>
                                    <t t-esc="employee.work_phone or 'N/A'"/>
                                </li>
                                <!-- <li class="list-group-item">
                                    <strong>Registration Number:</strong>
                                    <t t-esc="employee.registration_number or 'N/A'"/>
                                </li> -->
                            </ul>
                        </t>
                        <t t-else="">
                            <p class="text-muted text-center">No employee details available.</p>
                        </t>
                    </t>
                </div>
                <div id="o_my_sidebar"
                     class="o_portal_my_security mt-3 p-4 border rounded shadow-sm bg-white o_my_sidebar">
                    <div class="o_my_contact" t-if="sales_user">
                        <t t-call="portal.portal_contact"/>
                    </div>
                    <div class="o_portal_my_details">
                        <h4>Details
                            <a role="button" href="/my/account" class="btn btn-sm btn-link">
                                <i class="fa fa-pencil"/>
                                Edit
                            </a>
                        </h4>
                        <hr class="mt-1 mb-0"/>
                        <div t-field="user_id.partner_id"
                             t-options='{"widget": "contact", "fields": ["email", "phone", "address", "name"]}'/>
                    </div>
                    <div class="o_portal_my_security mt-3">
                        <h4>Account Security</h4>
                        <hr class="mt-1 mb-1"/>
                        <a href="/my/security"><i class="fa fa-pencil mx-1"/>Edit Security Settings
                        </a>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
    <template id="portal_my_payslips_menu" inherit_id="portal.portal_breadcrumbs" priority="30">
