    <template id="portal_my_home_base_override"
          inherit_id="portal.portal_my_home"
          priority="50">

        <!-- Make the main docs container a grid -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="attributes">
            <attribute name="class">o_portal_docs</attribute>
        </xpath>

        <!-- Remove row/grid classes from all category divs so they flow into our CSS grid -->
        <xpath expr="//div[@id='portal_alert_category']" position="attributes">
            <attribute name="class">o_portal_category</attribute>
            <attribute name="id">portal_alert_category</attribute>
        </xpath>

        <xpath expr="//div[@id='portal_client_category']" position="attributes">
            <attribute name="class">o_portal_category</attribute>
            <attribute name="id">portal_client_category</attribute>
        </xpath>

        <xpath expr="//div[@id='portal_service_category']" position="attributes">
            <attribute name="class">o_portal_category</attribute>
            <attribute name="id">portal_service_category</attribute>
        </xpath>

        <xpath expr="//div[@id='portal_vendor_category']" position="attributes">
            <attribute name="class">o_portal_category</attribute>
            <attribute name="id">portal_vendor_category</attribute>
        </xpath>

        <xpath expr="//div[@id='portal_common_category']" position="attributes">
            <attribute name="class">o_portal_category</attribute>
            <attribute name="id">portal_common_category</attribute>
        </xpath>

        <!-- Replace Connection & Security to remove icon and text -->
        <xpath expr="//div[@id='portal_common_category']" position="replace">
            <div id="portal_common_category" class="o_portal_category">
                <t t-call="portal.portal_docs_entry" t-if="False"/>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Connection &amp; Security</t>
                    <t t-set="url" t-value="'/my/security'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="show_count" t-value="True"/>
                </t>
            </div>
        </xpath>

    </template>


