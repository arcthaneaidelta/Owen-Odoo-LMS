    <template id="portal_my_home_project_override"
          inherit_id="project.portal_my_home"
          priority="50">
        <xpath expr="//div[@id='portal_service_category']" position="replace">
            <div id="portal_service_category">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Projects</t>
                    <t t-set="url" t-value="'/my/projects'"/>
                    <t t-set="placeholder_count" t-value="'project_count'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="show_count" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Tasks</t>
                    <t t-set="url" t-value="'/my/tasks'"/>
                    <t t-set="placeholder_count" t-value="'task_count'"/>
                    <t t-set="config_card" t-value="True"/>
                    <t t-set="show_count" t-value="True"/>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_my_home_invoice_override"
