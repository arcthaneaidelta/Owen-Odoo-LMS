<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_loans" name="My Loan Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Loan Requests</t>
            </t>
            <a t-attf-href="/create/my_loan?{{ keep_query() }}"><button type="button" class="mt-2 mb-2 btn btn-info btn-md" id="create_loans">Create a Loan Request</button></a>
            <p class="alert alert-danger mt8" t-if="request.params.get('error_msg')" role="alert">
                <t t-esc="request.params.get('error_msg')" />
            </p>
            <t t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Employee</th>
                        <th>Requested Date</th>
                        <th>Month</th>
                        <th>Amount</th>
                        <th class="text-right">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="loan_requests" t-as="loan">
                        <tr>
                            <td><a t-attf-href="/my/loan/#{loan.id}?{{ keep_query() }}"><span t-field="loan.name" /></a></td>
                            <td><span t-field="loan.employee_id" /></td>
                            <td><span t-field="loan.requested_date" t-options='{"widget": "datetime"}' /></td>
                            <td><span t-esc="time.strftime('%b %Y',time.strptime(str(loan.month),'%Y-%m-%d'))" /></td>
                            <td><span t-field="loan.amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: loan.currency_id}" /> </td>
                            <td class="text-right">
                                <t t-value="dict(loan.fields_get(allfields=['state'])['state']['selection'])[loan.state]" t-set="state" />
                                <t t-if="loan.state == 'new'">
                                    <span class="badge badge-pill badge-info" style="background-color: #999999; color: black;" title="Current stage of the task" t-esc="state" />
                                </t>
                                <t t-if="loan.state == 'approve'">
                                    <span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-esc="state" />
                                </t>
                                <t t-if="loan.state == 'refuse'">
                                    <span class="badge badge-pill badge-info" style="background-color: #ff0000; color: black;" title="Current stage of the task" t-esc="state" />
                                </t>
                                <t t-if="loan.state == 'cancel'">
                                    <span class="badge badge-pill badge-info" style="background-color: #ff7700; color: black;" title="Current stage of the task" t-esc="state" />
                                </t>
                            </td>
                            <td>
                                <a t-attf-href="/my/loan/delete/#{loan.id}?{{ keep_query() }}" t-if="loan.state=='new'">
                                    <span class="fa fa-trash-o remove-optionnal-item" title="Delete" aria-label="Delete" />
                                </a>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>
    <template id="portal_my_loan" name="My Loan Request">
        <t t-call="portal.portal_layout">
            <p class="alert alert-danger mt8" t-if="request.params.get('error_msg')" role="alert">
                <t t-esc="request.params.get('error_msg')" />
            </p>
            <form data-model_name="loan.requests" t-attf-action="/loan/update/{{loan.id}}" method="post" class=" form-horizontal container-fluid" enctype="multipart/form-data">
                <div class="card mt-4">
<div class="card-header">
                        <div class="row no-gutters">
                            <div class="col-md">
                                <h5 class="mb-1 mb-md-0">
                                    <span t-esc="loan.name" style="text-transform: uppercase;" />
                                    <t t-value="dict(loan.fields_get(allfields=['state'])['state']['selection'])[loan.state]" t-set="state" />
                                    <t t-if="loan.state == 'new'">
                                        <span class="badge badge-pill badge-info" style="background-color: #999999; color: black;" title="Current stage of the task" t-esc="state" />
                                    </t>
                                    <t t-if="loan.state == 'approve'">
                                        <span class="badge badge-pill badge-info" style="background-color: #0bdb12; color: black;" title="Current stage of the task" t-esc="state" />
                                    </t>
                                    <t t-if="loan.state == 'refuse'">
                                        <span class="badge badge-pill badge-info" style="background-color: #ff0000; color: black;" title="Current stage of the task" t-esc="state" />
                                    </t>
                                    <t t-if="loan.state == 'cancel'">
                                        <span class="badge badge-pill badge-info" style="background-color: #ff7700; color: black;" title="Current stage of the task" t-esc="state" />
                                    </t>
                                </h5>
                                <div class="mb-1 mb-md-0 mt-2">
                                    <span t-if="loan.state == 'new' " style="color: #17a2b8;">
                                        Your requested loan is yet to be approved by your loan Manager.
                                        <br />
                                        To edit your loan, kindly fill up the updated details and click on save if it is still in new or new stage.
                                    </span>
                                    <span t-if="loan.state == 'refuse' " class="text-danger">
                                        Your loan is refused by your loan manager.
                                    </span>
                                    <span t-if="loan.state == 'approve' " style="color: #0bdb12;">
                                        Congratulations, your loan is approved by your loan manager.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row no-gutters">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group mt-2 ">
                                    <div class="col-sm-12">
                                        <label for="name" class="col-md-2 col-sm-2">Name/Description*:</label>
                                        <input id="name" name="name" type="text" string="Name/Description" class="form-control mt-1 col-md-9 col-sm-9" t-att-value="loan.name" required="required" placeholder='Name/Description' t-att-readonly="loan.state != 'new' or None" />
                                    </div>
                                </div>
                                <div class="form-group mt-2 row d-flex justify-content-between flex-wrap">
                                    <div class="col-sm-12">
                                        <label for="month" class="col-md-2 col-sm-2">For Month*:</label>
                                        <input id="month" name="month" type="date" onclick="this.showPicker()" string="For Month" class="form-control mt-1 datetimepicker-input col-md-4 col-sm-4" t-att-value="loan.month if loan.month else datetime.date.today().strftime('%m-%d-%Y')" required="required" placeholder='For Month' t-att-disabled="loan.state != 'new' or None" />
                                    </div>
                                </div>
                                <div class="form-group mt-2 row d-flex justify-content-between flex-wrap">
                                    <div class="col-sm-12">
                                        <label for="amount" class="col-md-2 col-sm-2">Amount*:</label>
                                        <input id="amount" name="amount" type="number" step="0.1" string="Amount" class="form-control mt-1 datetimepicker-input col-md-4 col-sm-4" t-att-value="loan.amount" required="required" placeholder='300 e.g' t-att-disabled="loan.state != 'new' or None" />
                                    </div>
                                </div>
                                <div class="form-group mt-2 row d-flex justify-content-between flex-wrap">
                                    <div class="col-sm-12">
                                        <label for="reason" class="col-md-2 col-sm-2">Reason*:</label>
                                        <input id="reason" name="reason" type="text" string="Reason" class="form-control mt-1 datetimepicker-input col-md-4 col-sm-4" t-att-value="loan.reason" required="required" placeholder='For Month' t-att-disabled="loan.state != 'new' or None" />
                                    </div>
                                </div>
                                <div class="mt-4 mb-2 col-md text-md-right d-flex">
                                    <a t-attf-href="/my/my_loans">
                                        <button class="btn btn-danger btn-md" type="button" special="cancel">Close</button>
                                    </a>
                                    <t t-if="loan.state in ['new']">
                                        <button class="btn btn-primary btn-md" type="submit" id="save_loan" style="margin-left:5px;">Update</button>
                                    </t>
                                    <a t-attf-href="/my/loan/delete/#{loan.id}?{{ keep_query() }}" t-if="loan.state=='new'" class="d-flex mt-1" style="margin-left:5px;">
                                        <span class="fa fa-trash-o fa-2x remove-optionnal-item" title="Delete" aria-label="Delete" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt32">
                    <h4><strong>Message and communication history</strong></h4>
                    <t t-call="portal.message_thread" />
                </div>
            </form>
        </t>
    </template>
    <template id="portal_my_loan_create" name="Create a New Loan Request">
        <t t-call="portal.portal_layout">
            <p class="alert alert-danger mt8" t-if="request.params.get('error_msg')" role="alert">
                <t t-esc="request.params.get('error_msg')" />
            </p>
            <form data-model_name="loan.requests" t-attf-action="/create/loan?{{ keep_query() }}" method="post" class=" form-horizontal container-fluid" enctype="multipart/form-data" id="leave_request_form">
                <div class="card mt-4">
                    <div class="card-header">
                        <div class="row no-gutters">
                            <div class="col-md">
                                <h3 class="mt-2 mb-2 text-left">
                                    Create a New Loan Request
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row no-gutters">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group mt-2">
                                    <div class="col-sm-12">
                                        <label for="name" class="col-md-2 col-sm-2">Name/Description*:</label>
                                        <input id="name" name="name" type="text" string="Name/Description" class="form-control mt-1 col-md-9 col-sm-9" required="required" placeholder='abc e.g' />
                                    </div>
                                </div>
                                <div class="form-group mt-2">
                                    <div class="col-sm-12">
                                        <label for="month" class="col-md-2 col-sm-2">For Month*:</label>
                                        <input id="month" name="month" type="month" string="Date" class="form-control mt-1 datetimepicker-input col-md-4 col-sm-4" required="required" placeholder='For Month' />
                                    </div>
                                </div>
                                <div class="form-group mt-2">
                                    <div class="col-sm-12">
                                        <label for="amount" class="col-md-2 col-sm-2">Amount*:</label>
                                        <input id="amount" name="amount" type="number" step="0.1" string="Date" class="form-control mt-1 datetimepicker-input col-md-4 col-sm-4" required="required" placeholder='300 e.g' />
                                    </div>
                                </div>
                                <div class="form-group mt-2">
                                    <div class="col-sm-12">
                                        <label for="reason" class="col-md-2 col-sm-2">Reason*:</label>
                                        <input id="reason" name="reason" type="text" string="Reason" class="form-control mt-1 datetimepicker-input col-md-4 col-sm-4" required="required" placeholder='XYZ e.g' />
                                    </div>
                                </div>
                                <div class="mt-4 mb-2 col-md text-md-right d-flex">
                                    <a t-attf-href="/my/my_loans">
                                        <button class="btn btn-danger btn-md" type="button" special="cancel">Close</button>
                                    </a>
                                    <button class="btn btn-primary btn-md" type="submit" id="save_loan" style="margin-left:5px;">Create</button>
                                </div>
                            </div>
                        </div>
                    </div>
</div>
            </form>
        </t>
    </template>
</odoo>