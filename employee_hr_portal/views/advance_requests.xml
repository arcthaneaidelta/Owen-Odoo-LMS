<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="advance_requests_config_form_view" model="ir.ui.view">
            <field name="name">advance.requests.form.view</field>
            <field name="model">advance.requests</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_reset" invisible="state not in ('approve', 'cancel')" string="Reset To New" type="object" class="oe_highlight"/>
                        <button name="action_approve" invisible="state != 'new'" string="Approve" type="object" class="oe_highlight"/>
                        <button name="create_bill" invisible="state != 'approve'" string="Create Bill" type="object" class="oe_highlight"/>
                        <button name="action_refuse" invisible="state != 'new'" string="Refuse" type="object" class="oe_highlight"/>
                        <button name="action_cancel" invisible="state not in ('new', 'approve', 'refuse')" string="Cancel" type="object" class="oe_highlight"/>
                        <field name="state" widget="statusbar" string="confirm" statusbar_visible="new,approve,refuse,cancel" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="show_created_invs" type="object" class="oe_stat_button" icon="fa-dollar" 
                                invisible="created_invoices_count == 0">
                                <div class="o_field_widget o_stat_info">
                                    <field name="created_invoices_count" class="o_stat_value" />
                                    <span class="o_stat_text">Bill</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <div class="oe_title">
                                <h1>
                                    <field name="name" required="1" placeholder="XYX..." />
                                    <field name="seq_number" readonly="1" force_save="1" />
                                    <br />
                                </h1>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" required="1" 
                                    options='{"no_create": True,"no_open": True, "no_create_edit": True}' 
                                    readonly="state != 'new'">
                                </field>
                                <field name="contract_id" required="1" 
                                    options='{"no_create": True,"no_open": True, "no_create_edit": True}' 
                                    readonly="state != 'new'" 
                                    domain="[('employee_id','=',employee_id),('state','=','open')]">
                                </field>
                                <field name="requested_date" readonly="1"></field>
                                <field name="month" required="1" readonly="state != 'new'"></field>
                                <field name="amount" required="1" readonly="state != 'new'"></field>
                            </group>
                            <group>
                                <field name="company_id" readonly="1" options='{"no_create": True,"no_open": True, "no_create_edit": True}'></field>
                                <field name="user_id" readonly="1" options='{"no_create": True,"no_open": True, "no_create_edit": True}'></field>
                                <field name="currency_id" readonly="1"></field>
                                <field name="advance_limit" readonly="1"></field>
                                <field name="availed_advance_amount" readonly="1"></field>
                            </group>
                        </group>
                        <notebook>
                            <page string="Reason/Description" name="reason">
                                <field name="reason" required="1" readonly="state != 'new'"></field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>
        <record id="advance_requests_config_tree_view" model="ir.ui.view">
            <field name="name">advance.requests.view.tree</field>
            <field name="model">advance.requests</field>
            <field name="arch" type="xml">
                <list>
                    <field name="seq_number" readonly="1" force_save="1" />
                    <field name="name"></field>
                    <field name="employee_id"></field>
                    <field name="requested_date"></field>
                    <field name="month"></field>
                    <field name="amount"></field>
                    <field name="currency_id"></field>
                    <field name="state"></field>
                    <field name="return_state"></field>
                    <field name="company_id" optional="hide"></field>
                    <field name="user_id" optional="hide"></field>
                </list>
            </field>
        </record>
        <record id="advance_requests_search_view" model="ir.ui.view">
            <field name="name">advance.requests.view.search</field>
            <field name="model">advance.requests</field>
            <field name="arch" type="xml">
                <search string="Advance Requests">
                    <field name="seq_number" readonly="1" force_save="1" />
                    <field name="name"></field>
                    <field name="employee_id"></field>
                    <field name="requested_date"></field>
                    <field name="month"></field>
                    <field name="amount"></field>
                    <field name="currency_id"></field>
                    <field name="state"></field>
                    <field name="return_state"></field>
                    <field name="company_id"></field>
                    <field name="user_id"></field>
                    <separator />
                    <filter name="Not_Returned" string="Not Returned" domain="[('return_state', '=', 'no')]" />
                    <filter name="Returned" string="Returned" domain="[('return_state', '=', 'yes')]" />
                    <filter name="new" string="New" domain="[('state', '=', 'new')]" />
                    <filter name="approve" string="Approved" domain="[('state', '=', 'approve')]" />
                    <filter name="refuse" string="Refuse" domain="[('state', '=', 'refuse')]" />
                    <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]" />
                    <separator />
                    <group expand="0" string="Group By">
                        <filter string="Return Status" name="status_return" domain="[]" context="{'group_by': 'return_state'}" />
                        <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}" />
                        <filter string="Requested Date" name="requested_date" domain="[]" context="{'group_by': 'requested_date'}" />
                        <filter string="For Month/Date" name="month" domain="[]" context="{'group_by': 'month'}" />
                        <filter string="Employee" name="employee_id" domain="[]" context="{'group_by': 'employee_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_advance_requests_config">
            <field name="name">Advance Requests</field>
            <field name="res_model">advance.requests</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="menu_payroll_others" name="Others" parent="om_hr_payroll.menu_hr_payroll_root" sequence="71" groups="om_hr_payroll.group_hr_payroll_manager" />
        <menuitem id="menu_advance_requests_config" name="Advance Requests" parent="employee_hr_portal.menu_payroll_others" sequence="1" action="action_advance_requests_config" groups="om_hr_payroll.group_hr_payroll_manager" />
        <!-- hr contract view -->
        <record id="view_hr_contract_view_form_ext" model="ir.ui.view">
            <field name="name">hr.contract.view.form.ext</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='hr_responsible_id']" position="after">
                    <field name="advance_limit" groups="om_hr_payroll.group_hr_payroll_manager" readonly="0" force_save="1"></field>
                    <field name="advance_limit" groups="!om_hr_payroll.group_hr_payroll_manager" readonly="1" force_save="1"></field>
                    <field name="availed_advance_amount" force_save="1" readonly="1"></field>
                </xpath>
            </field>
        </record>
    </data>
</odoo>