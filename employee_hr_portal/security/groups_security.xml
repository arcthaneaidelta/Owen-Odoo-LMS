<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Custom HR Portal Category -->
        <record model="ir.module.category" id="module_category_custom_hr_portal">
            <field name="name">Employee HR Portal</field>
            <field name="visible">True</field>
            <field name="sequence">200</field>
        </record>

        <!-- User Group -->
        <record id="access_to_employee_portal_custom_user" model="res.groups">
            <field name="name">User</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
            <field name="category_id" ref="employee_hr_portal.module_category_custom_hr_portal" />
        </record>

        <!-- Manager Group -->
        <record id="access_to_quot_manager_custom" model="res.groups">
            <field name="name">Manager</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
            <field name="category_id" ref="employee_hr_portal.module_category_custom_hr_portal" />
            <field name="implied_ids" eval="[(4, ref('access_to_employee_portal_custom_user'))]" />
        </record>

