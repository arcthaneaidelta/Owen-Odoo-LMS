        <!-- HR Leave Rule Example (kept from old) -->
        <record id="hr_leave_manager_rule" model="ir.rule">
            <field name="name">HR Leave: Only See Subordinates</field>
            <field name="model_id" ref="model_hr_leave"/>
            <field name="domain_force">
                ['|',
                    ('employee_id', '=', False),
                    ('employee_id.parent_id', '=', user.employee_id.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>

        <record id="show_all_Leave" model="res.groups">
            <field name="name">Show All Leave</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record> 
        <record id="group_show_all_missing_punch" model="res.groups">
            <field name="name">Show All Missing Punches</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        <record id="approve_missing_punch" model="res.groups">
            <field name="name">All Missing Puch Approve</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
        <record id="show_all_Leave_approve" model="res.groups">
            <field name="name">All Leave Approve</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record> 

        <record id="access_to_allow_portal_group_access" model="res.groups">
            <field name="name">Allow Create Leaves From Portal</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
        </record>

    </data>
