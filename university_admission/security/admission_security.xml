<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Medical committee can only write on records in medical_review stage -->
        <record id="rule_admission_medical_committee" model="ir.rule">
            <field name="name">Medical Committee: Only Medical Review Stage</field>
            <field name="model_id" search="[('model','=','university.admission')]"/>
            <field name="groups" eval="[(4, ref('university_core.group_medical_committee'))]"/>
            <field name="domain_force">[('state','=','medical_review')]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>
    </data>
</odoo>
