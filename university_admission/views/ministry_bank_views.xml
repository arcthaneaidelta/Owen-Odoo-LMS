<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ MINISTRY BATCH — KANBAN VIEW ══════════════════════════════════════ -->
    <record id="view_ministry_batch_kanban" model="ir.ui.view">
        <field name="name">university.ministry.batch.kanban</field>
        <field name="model">university.ministry.batch</field>
        <field name="arch" type="xml">
            <kanban default_group_by="" class="o_kanban_small_column">
                <field name="name"/>
                <field name="entry_year"/>
                <field name="record_count"/>
                <field name="import_date"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>Entry Year: <strong><field name="entry_year"/></strong></div>
                                    <div>Records: <strong><field name="record_count"/></strong></div>
                                    <div>Imported: <field name="import_date"/></div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <button name="action_import_excel"
                                            type="object"
                                            class="btn btn-sm btn-primary">
                                        Import Excel
                                    </button>
                                    <button name="action_view_records"
                                            type="object"
                                            class="btn btn-sm btn-secondary ms-1">
                                        View Records
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══ MINISTRY BATCH — LIST VIEW ════════════════════════════════════════ -->
    <record id="view_ministry_batch_list" model="ir.ui.view">
        <field name="name">university.ministry.batch.list</field>
        <field name="model">university.ministry.batch</field>
        <field name="arch" type="xml">
            <list string="Ministry Batches">
                <field name="name"/>
                <field name="entry_year"/>
                <field name="import_date"/>
                <field name="record_count"/>
            </list>
        </field>
    </record>

    <!-- ═══ MINISTRY BATCH — FORM VIEW ════════════════════════════════════════ -->
    <record id="view_ministry_batch_form" model="ir.ui.view">
        <field name="name">university.ministry.batch.form</field>
        <field name="model">university.ministry.batch</field>
        <field name="arch" type="xml">
            <form string="Ministry Batch">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="record_count" widget="statinfo" string="Records"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Batch 2021/2022"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="entry_year"/>
                            <field name="import_date"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <div class="mt-3">
                        <button name="action_import_excel" type="object"
                                class="btn btn-primary">
                            Import Ministry Excel
                        </button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══ MINISTRY BANK — LIST VIEW (records inside a batch) ════════════════ -->
    <record id="view_ministry_bank_list" model="ir.ui.view">
        <field name="name">university.ministry.bank.list</field>
        <field name="model">university.ministry.bank</field>
        <field name="arch" type="xml">
            <list string="Ministry Bank Records"
                  decoration-success="is_matched == True"
                  decoration-muted="is_matched == True">
                <field name="ministry_form_number"/>
                <field name="display_name_ar"/>
                <field name="national_id"/>
                <field name="entry_year"/>
                <field name="academic_year_str"/>
                <field name="batch_number"/>
                <field name="program_code"/>
                <field name="faculty_name_ar"/>
                <field name="internal_admission_type"/>
                <field name="citizenship"/>
                <field name="starting_level"/>
                <field name="is_matched" widget="boolean_toggle"/>
                <field name="matched_admission_id"/>
            </list>
        </field>
    </record>

    <!-- ═══ MINISTRY BANK — SEARCH VIEW ════════════════════════════════════════ -->
    <record id="view_ministry_bank_search" model="ir.ui.view">
        <field name="name">university.ministry.bank.search</field>
        <field name="model">university.ministry.bank</field>
        <field name="arch" type="xml">
            <search>
                <field name="ministry_form_number" string="FRMNO"/>
                <field name="display_name_ar"/>
                <field name="national_id"/>
                <field name="entry_year"/>
                <field name="batch_id"/>
                <separator/>
                <filter string="Not Yet Matched" name="unmatched"
                        domain="[('is_matched','=',False)]"/>
                <filter string="Matched" name="matched"
                        domain="[('is_matched','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Batch" name="grp_batch"
                            context="{'group_by':'batch_id'}"/>
                    <filter string="Entry Year" name="grp_year"
                            context="{'group_by':'entry_year'}"/>
                    <filter string="Program" name="grp_program"
                            context="{'group_by':'program_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══ IMPORT WIZARD ════════════════════════════════════════════════════ -->
    <record id="view_ministry_import_wizard_form" model="ir.ui.view">
        <field name="name">university.ministry.import.wizard.form</field>
        <field name="model">university.ministry.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Ministry Excel">
                <group invisible="state == 'done'">
                    <field name="batch_id"/>
                    <field name="excel_file" widget="binary" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="result_message" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_close" string="Close" type="object"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" invisible="state == 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══ ACTIONS ══════════════════════════════════════════════════════════ -->
    <record id="action_ministry_batch" model="ir.actions.act_window">
        <field name="name">Ministry Bank</field>
        <field name="res_model">university.ministry.batch</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_ministry_bank_all" model="ir.actions.act_window">
        <field name="name">All Ministry Records</field>
        <field name="res_model">university.ministry.bank</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ministry_bank_search"/>
    </record>

</odoo>
