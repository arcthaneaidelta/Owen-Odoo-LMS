<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_university_academic_status_form" model="ir.ui.view">
        <field name="name">university.academic.status.form</field>
        <field name="model">university.student.academic.status</field>
        <field name="arch" type="xml">
            <form string="Academic Status">
                <header>
                    <button name="action_confirm" string="Confirm Results" type="object" invisible="state != 'draft'" class="oe_highlight" confirm="Are you sure you want to apply these results? This will update the student's status, level, and potentially expel them."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="academic_year_id" readonly="state != 'draft'"/>
                            <field name="level" readonly="state != 'draft'"/>
                        </group>

                        <group>
                            <field name="status_result" readonly="state != 'draft'"/>
                            
                            <field name="failed_subject_ids"
                                   widget="many2many_tags"
                                   invisible="status_result != 'repeating_some'"
                                   readonly="state != 'draft'"/>
                            
                            <field name="current_gpa" readonly="1"/>
                            <field name="cumulative_gpa" readonly="1"/>
                            
                            <field name="repetition_invoice_id"
                                   invisible="status_result not in ['repeating_all', 'repeating_some']"/>
                        </group>
                    </group>
                    <notebook invisible="state != 'draft'">
                         <page string="Actions">
                             <button name="action_compute_results" 
                                     string="Compute Final Results" 
                                     type="object" 
                                     class="btn-primary" 
                                     invisible="state != 'draft'"/>
                         </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_university_academic_status_tree" model="ir.ui.view">
        <field name="name">university.academic.status.tree</field>
        <field name="model">university.student.academic.status</field>
        <field name="arch" type="xml">
            <list string="Academic Results">
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="level"/>
                <field name="status_result"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_academic_status" model="ir.actions.act_window">
        <field name="name">End-of-Year Results</field>
        <field name="res_model">university.student.academic.status</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_academic_status"
              name="End-of-Year Results"
              parent="menu_university_results_root"
              action="action_academic_status"
              sequence="10"/>
</odoo>
