<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_student_subject_score_form" model="ir.ui.view">
        <field name="name">student.subject.score.form</field>
        <field name="model">university.student.subject.score</field>
        <field name="arch" type="xml">
            <form string="Student Exam Score">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="academic_year_id"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="subject_id" domain="[('year_level', '=', level)]"/>
                            <field name="exam_round"/>
                            <field name="score"/>
                            <field name="is_pass" decoration-success="is_pass" decoration-danger="not is_pass"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_student_subject_score_tree" model="ir.ui.view">
        <field name="name">student.subject.score.tree</field>
        <field name="model">university.student.subject.score</field>
        <field name="arch" type="xml">
            <list string="Student Exam Scores" editable="bottom">
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="level"/>
                <field name="subject_id"/>
                <field name="exam_round"/>
                <field name="score"/>
                <field name="result_status" widget="badge" decoration-success="result_status == 'pass'" decoration-danger="result_status == 'fail'"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_student_subject_score" model="ir.actions.act_window">
        <field name="name">Exam Scores</field>
        <field name="res_model">university.student.subject.score</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_student_subject_score"
              name="Exam Scores"
              parent="menu_university_results_root"
              action="action_student_subject_score"
              sequence="5"/>
</odoo>
