<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_university_timetable_template_form" model="ir.ui.view">
        <field name="name">university.timetable.template.form</field>
        <field name="model">university.timetable.template</field>
        <field name="arch" type="xml">
            <form string="Timetable Template">
                <header>
                    <button name="action_apply_to_batch" string="Apply Template to Batch" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. CS Level 1 Temp 1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_id"/>
                            <field name="level"/>
                            <field name="semester"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="session_type"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_university_timetable_template_tree" model="ir.ui.view">
        <field name="name">university.timetable.template.tree</field>
        <field name="model">university.timetable.template</field>
        <field name="arch" type="xml">
            <list string="Timetable Templates">
                <field name="name"/>
                <field name="program_id"/>
                <field name="level"/>
                <field name="semester"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_timetable_template" model="ir.actions.act_window">
        <field name="name">Timetable Templates</field>
        <field name="res_model">university.timetable.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <!-- <menuitem id="menu_timetable_template"
              name="Timetable Templates"
              parent="university_registrar.menu_curriculum"
              action="action_timetable_template"
              sequence="10"/> -->
</odoo>
