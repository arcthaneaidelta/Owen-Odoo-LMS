<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_university_unfreeze_request_form" model="ir.ui.view">
        <field name="name">university.unfreeze.request.form</field>
        <field name="model">university.student.unfreeze.request</field>
        <field name="arch" type="xml">
            <form string="Unfreeze Request">
                <header>
                    <button name="action_send_otp"
                            string="Send OTP"
                            type="object"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>

                    <button name="%(action_unfreeze_otp_verify)d"
                            string="Verify OTP"
                            type="action"
                            invisible="state != 'otp_sent'"
                            class="oe_highlight"/>

                    <button name="action_registrar_approve"
                            string="Registrar Approve"
                            type="object"
                            invisible="state != 'submitted'"
                            class="oe_highlight"
                            groups="university_core.group_registrar"/>

                    <button name="action_head_approve"
                            string="Academic Affairs Approve"
                            type="object"
                            invisible="state != 'registrar_approved'"
                            class="oe_highlight"
                            groups="university_core.group_head_admissions"/>

                    <button name="action_complete_unfreeze"
                            string="Activate Unfreeze (Complete)"
                            type="object"
                            invisible="state != 'approved'"
                            class="oe_highlight"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state not in ['submitted', 'registrar_approved']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,otp_sent,submitted,registrar_approved,approved,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="program_id"/>
                            <field name="academic_year_name" readonly="state != 'draft'"/>
                            <field name="freeze_request_id" readonly="state != 'draft'"/>
                            <field name="otp_verified" readonly="1"/>
                        </group>
                        <group>
                            <field name="reason_details" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_university_unfreeze_request_tree" model="ir.ui.view">
        <field name="name">university.unfreeze.request.tree</field>
        <field name="model">university.student.unfreeze.request</field>
        <field name="arch" type="xml">
            <list string="Unfreeze Requests">
                <field name="name"/>
                <field name="student_id"/>
                <field name="academic_year_name"/>
                <field name="state" decoration-info="state == 'draft'" decoration-success="state == 'completed'" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_unfreeze_request" model="ir.actions.act_window">
        <field name="name">Unfreeze Requests</field>
        <field name="res_model">university.student.unfreeze.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_unfreeze_requests"
              name="Unfreeze Requests"
              parent="university_registrar.menu_student_affairs"
              action="action_unfreeze_request"
              sequence="11"/>
</odoo>
