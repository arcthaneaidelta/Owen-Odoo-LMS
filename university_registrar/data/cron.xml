<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_check_unregistered_expulsion" model="ir.cron">
            <field name="name">Registrar: Auto-Expel Unregistered Students</field>
            <field name="model_id" ref="university_student.model_university_student"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_unregistered_expulsion()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_check_max_duration_expulsion" model="ir.cron">
            <field name="name">Registrar: Auto-Expel Max Duration Exceeded</field>
            <field name="model_id" ref="university_student.model_university_student"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_max_duration_expulsion()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
